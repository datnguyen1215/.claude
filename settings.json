{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "enabledMcpjsonServers": [
    "playwright"
  ],
  "env": {
    "TMPDIR": "/home/dnguyen/tmp",
    "DISABLE_AUTOUPDATER": "1"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/format-single-file.sh"
          }
        ]
      }
    ]
  },
  "alwaysThinkingEnabled": false,
  "effortLevel": "medium",
  "tui": "fullscreen",
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "verbose": true,
  "voiceEnabled": false
}
